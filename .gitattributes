# Auto detect text files and perform LF normalization
* text=auto

# Development-only docs: never ship inside the plugin zip built from a git
# archive (moodle.org plugin directory, `git archive`, etc). CLAUDE.md in
# particular contains local machine paths and an in-progress rename narrative
# that only make sense during development.
CLAUDE.md export-ignore
SPEC-cohortmembership.md export-ignore
claude-code-prompt.md export-ignore

# Repository tooling (CI and release workflows, registry metadata, git config):
# not part of the plugin. CAMP reads .camp/listing.yml from the git blob at the
# release commit, not from the archive, so ignoring it here is safe.
.github export-ignore
.camp export-ignore
.gitattributes export-ignore
.gitignore export-ignore
